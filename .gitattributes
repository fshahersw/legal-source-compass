# Imported source bytes and their provenance hashes must survive Windows checkouts.
public/data/** -text
# Checksum-pinned test evidence must retain repository bytes on Windows too.
src/lib/corpus/__fixtures__/entry-analysis-v4.json -text
# The generated SQL gate compares bytes with its LF-only source template.
database/contracts/legal-atlas-v3.body.sql text eol=lf
database/contracts/legal-atlas-v3.generated.sql text eol=lf
public/court-marks/* -text
# Publisher capture formatting is evidence; retain whitespace with its checksum.
public/data/limitations/text/** -whitespace
public/data/limitations/opinion-text/** -whitespace

# Original publisher regression captures retain their exact CRLF and whitespace.
scripts/legal/state-codes/b4/ks/fixtures/empty_second_number.html -text -whitespace
scripts/legal/state-codes/b4/ks/fixtures/repealed_stub.html -text -whitespace
# These upstream license texts use seven '=' characters as an RST heading.
public/visuals/licenses/*-LICENSE.txt -text conflict-marker-size=32
# Seals, flags, outlines and agency marks are hash-pinned in src/lib/visuals/registry.json.
public/visuals/** -text
# Node scripts keep LF everywhere: a CRLF after a #! line breaks Vitest's import of the script on Windows checkouts.
*.mjs text eol=lf
# Vendored data is pinned by SHA-256 of its repository bytes (scripts/vendor/*/PINNED.json); never convert line endings.
scripts/vendor/** -text
# Its SHA-256 is recorded in the generated pattern table (src/lib/citations/patterns.json).
scripts/citations_v2/pattern_source.py text eol=lf
